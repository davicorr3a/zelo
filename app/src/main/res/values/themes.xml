<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- DayNight: segue o modo claro ou escuro do sistema. As cores mudam pela pasta values-night. -->
    <style name="Tema.Zelo" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">@color/primaria</item>
        <item name="colorOnPrimary">@color/na_primaria</item>
        <item name="colorPrimaryContainer">@color/resposta</item>
        <item name="colorOnPrimaryContainer">@color/na_resposta</item>
        <item name="colorSurface">@color/superficie</item>
        <item name="colorOnSurface">@color/texto</item>
        <item name="android:colorBackground">@color/fundo</item>
        <item name="colorOnBackground">@color/texto</item>
        <item name="colorOutline">@color/contorno</item>
        <item name="colorError">@color/alerta</item>
        <item name="colorErrorContainer">@color/alerta_container</item>

        <item name="android:fontFamily">@font/atkinson</item>
        <item name="fontFamily">@font/atkinson</item>
    </style>

    <!-- Tipografia. Tudo em sp, para respeitar o tamanho de fonte escolhido nas configurações do celular. -->

    <style name="TextAppearance.Zelo.Titulo" parent="TextAppearance.Material3.HeadlineMedium">
        <item name="android:fontFamily">@font/atkinson</item>
        <item name="fontFamily">@font/atkinson</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textSize">32sp</item>
    </style>

    <style name="TextAppearance.Zelo.Corpo" parent="TextAppearance.Material3.BodyLarge">
        <item name="android:fontFamily">@font/atkinson</item>
        <item name="fontFamily">@font/atkinson</item>
        <item name="android:textSize">21sp</item>
    </style>

    <style name="TextAppearance.Zelo.Botao" parent="TextAppearance.Material3.LabelLarge">
        <item name="android:fontFamily">@font/atkinson</item>
        <item name="fontFamily">@font/atkinson</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textSize">20sp</item>
        <item name="android:textAllCaps">false</item>
    </style>

    <!-- Botões: altura mínima de 64dp, bem acima dos 48dp recomendados, pensando em dedos menos precisos -->

    <style name="Widget.Zelo.Botao.Principal" parent="Widget.Material3.Button">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">8dp</item>
        <item name="android:minHeight">64dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:paddingTop">12dp</item>
        <item name="android:paddingBottom">12dp</item>
        <item name="android:textAppearance">@style/TextAppearance.Zelo.Botao</item>
        <item name="cornerRadius">16dp</item>
    </style>

    <style name="Widget.Zelo.Botao.Secundario" parent="Widget.Material3.Button.OutlinedButton">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">8dp</item>
        <item name="android:minHeight">64dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:paddingTop">12dp</item>
        <item name="android:paddingBottom">12dp</item>
        <item name="android:textAppearance">@style/TextAppearance.Zelo.Botao</item>
        <item name="android:textColor">@color/primaria</item>
        <item name="cornerRadius">16dp</item>
        <item name="strokeWidth">2dp</item>
        <item name="strokeColor">@color/primaria</item>
    </style>

    <!-- Balões da conversa -->

    <style name="Widget.Zelo.Cartao" parent="Widget.Material3.CardView.Outlined">
        <item name="cardBackgroundColor">@color/superficie</item>
        <item name="strokeColor">@color/contorno</item>
        <item name="strokeWidth">@dimen/borda_cartao</item>
        <item name="cardCornerRadius">20dp</item>
    </style>

    <style name="Widget.Zelo.Cartao.Resposta" parent="Widget.Material3.CardView.Filled">
        <item name="cardBackgroundColor">@color/resposta</item>
        <item name="cardCornerRadius">20dp</item>
    </style>

</resources>
